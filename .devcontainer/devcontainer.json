// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "Python 3",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/python:3-3.13-trixie",
		"runArgs": ["--name", "Euler_App"],

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Adds Node.js and npm via Dev Container Features
  	"features": {
    	"ghcr.io/devcontainers/features/node:1": {
      	"version": "latest"
    	}
  	},


	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

  	"forwardPorts": [
    	6274,
    	6277
  	],

  	"portsAttributes": {
    	"6274": {
      	"label": "MCP Inspector UI",
      	"onAutoForward": "silent"
    	},
    	"6277": {
      	"label": "MCP Inspector Proxy",
      	"onAutoForward": "silent"
    	}
  	},

	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "pip3 install --user -r requirements.txt",
	"postCreateCommand": "sh ./scripts/postCreateCommand.sh",

	// Configure tool-specific properties.
	// "customizations": {},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-toolsai.jupyter",
				"tomoki1207.pdf",
				"ms-python.vscode-python-envs"
			],
			"settings": {
        		"python.envFile": "${workspaceFolder}/.env",
        		"terminal.useEnvFile": true,
 				"python.analysis.typeCheckingMode": "off",
				"workbench.browser.enableRemoteProxy": true,
        		"workbench.browser.dataStorage": "workspace"				
			}
		}
	}	
}
